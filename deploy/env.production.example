# setup.sh copies this to /opt/planetwatch/.env (readable only by the app) and fills in
# the __...__ values. Edit that copy on the server; never commit it.

# --- Flask ---
FLASK_SECRET_KEY=__SECRET_KEY__
DATABASE_URL=sqlite:///reports.db
# Behind nginx: trust its X-Forwarded-* headers (real client IP, https).
TRUSTED_PROXY=1
# Address that goes into the install QR code and share links.
PUBLIC_BASE_URL=https://__DOMAIN__

# --- Municipal dashboard sign-in ---
MUNICIPAL_USERNAME=admin
MUNICIPAL_PASSWORD=__MUNICIPAL_PASSWORD__

# --- Inference ---
YOLO_WEIGHTS=model/weights/best.pt
YOLO_CONF_THRESHOLD=0.25

# --- Email / SMS alerts: copy the values from your local .env to switch them on ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
ALERT_RECIPIENTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBERS=
